# Copie pra ".env" no servidor Hetzner e preencha com valores reais.
# Nunca comite o ".env" de verdade — ele já está no .gitignore.

DEBUG=False

# Gere uma chave forte, por exemplo com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Senha do Postgres (usada também pelo serviço "db" no docker-compose.prod.yml)
POSTGRES_PASSWORD=

# Domínio real, sem "https://" (ex: fazendabelavista.com.br). Precisa já
# estar com o DNS (registro A) apontando pro IP do servidor Hetzner antes
# de subir — é esse domínio que o Caddy usa pra pedir o certificado HTTPS
# automático, e falha se o DNS ainda não resolver pra esse IP.
# (ALLOWED_HOSTS/CSRF_TRUSTED_ORIGINS/CORS_ALLOWED_ORIGINS são montados a
# partir desse valor direto no docker-compose.prod.yml — não precisa
# repetir aqui.)
DOMAIN=
